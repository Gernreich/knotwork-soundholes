{"commands":[
{"command":"parameters.add","params":{"name":"ply","expression":"3 mm","comment":"the soundboard's thickness"}},
{"command":"parameters.add","params":{"name":"reach","expression":"32 mm","comment":"read only: the rosette's reach, its rim and bite and half a mm, from the cut file"}},
