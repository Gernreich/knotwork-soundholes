# How every shipped SVG in this repository is drawn. Checked by
# lasermade-tools/repro-svg.py; $OUT is where the file must be written.
#
# AMP and HW do NOT scale with R_HOLE, and the filename records only leads,
# bights and radius -- so for everything drawn at a non-default radius the
# command was unrecoverable from anything in the repository. On 2026-09-10 the
# four were recovered by reading each SVG's own description (ribbon width is
# 2*HW, the cosine amplitude is AMP, the rim overrun is BITE) and verified
# byte-identical. That is why this file exists.
#
# RUST SINCE 2026-11-02. The three generators were JavaScript run by Node; they
# are now knot_soundhole.rs, plait_soundhole.rs and preview.rs, and every file
# below redrew byte-identically from the port before the .js went. That takes
# Node's own arithmetic, not just the same formulas: src/jsmath.rs is V8's
# fdlibm sin/cos/atan2 with clang's fused multiply-adds, and src/jsfmt.rs is
# JavaScript's number-to-text. repro-svg.py runs `cargo build --release` once
# before any line here, so these always test the code as it stands. (They were
# `cargo run` for an hour: in parallel, one cargo re-linking the binary could
# pull it out from under another that was starting it.)

# --- knots at the 30mm default: AMP 7.5, HW 2.0, BITE 1.5 ---
2-lead_3-bight_knot_radius30mm.svg :: LEADS=2 BIGHTS=3 R_HOLE=30 OUT=$OUT target/release/knot_soundhole
2-lead_5-bight_knot_radius30mm.svg :: LEADS=2 BIGHTS=5 R_HOLE=30 OUT=$OUT target/release/knot_soundhole
2-lead_7-bight_knot_radius30mm.svg :: LEADS=2 BIGHTS=7 R_HOLE=30 OUT=$OUT target/release/knot_soundhole
3-lead_2-bight_knot_radius30mm.svg :: LEADS=3 BIGHTS=2 R_HOLE=30 OUT=$OUT target/release/knot_soundhole
3-lead_4-bight_knot_radius30mm.svg :: LEADS=3 BIGHTS=4 R_HOLE=30 OUT=$OUT target/release/knot_soundhole
3-lead_5-bight_knot_radius30mm.svg :: LEADS=3 BIGHTS=5 R_HOLE=30 OUT=$OUT target/release/knot_soundhole

# --- the four whose parameters were recorded nowhere ---
# above three leads the ribbon must thin and AMP/HW has to grow with LEADS:
# about 3.75 at four leads, 6.25 at five, 15.6 at nine.
4-lead_3-bight_knot_radius39mm.svg :: LEADS=4 BIGHTS=3 R_HOLE=39 AMP=9.75 HW=2.6 BITE=1.5 OUT=$OUT target/release/knot_soundhole
4-lead_5-bight_knot_radius39mm.svg :: LEADS=4 BIGHTS=5 R_HOLE=39 AMP=9.75 HW=2.6 BITE=1.5 OUT=$OUT target/release/knot_soundhole
5-lead_4-bight_knot_radius60mm.svg :: LEADS=5 BIGHTS=4 R_HOLE=60 AMP=15 HW=2.4 BITE=1.5 OUT=$OUT target/release/knot_soundhole
# ~40s: nine leads over eleven bights is 99 crossings to resolve.
9-lead_11-bight_knot_radius300mm.svg :: LEADS=9 BIGHTS=11 R_HOLE=300 AMP=78 HW=5 BITE=1.5 OUT=$OUT target/release/knot_soundhole

# --- plaits: N is lobes per ribbon, so 2N crossings ---
8-crossing_plait_radius30mm.svg :: N=4 R_HOLE=30 OUT=$OUT target/release/plait_soundhole
10-crossing_plait_radius30mm.svg :: N=5 R_HOLE=30 OUT=$OUT target/release/plait_soundhole
# the one plait whose AMP/HW/BITE were in a code comment rather than lost
10-crossing_plait_radius50mm.svg :: N=5 R_HOLE=50 AMP=10.8 HW=3.3 BITE=2.5 OUT=$OUT target/release/plait_soundhole

# --- the previews ship without a generator ---
# Display renderings only, embedded in README.md and index.md; nothing here
# cuts them. They are FILLED even-odd in gold and white, which is not what
# lasermade-tools/make-preview.py draws -- that thickens the cut stroke.
#
# They carried a "!" until 2026-09-10, meaning "shipped without a generator, we
# know". That was the wrong mark for them: an acknowledged exception is the right
# answer for a drawing made by hand, and every one of these is a mechanical
# transform of a file that is itself generated. preview.js did it, and all
# thirteen come out BYTE-IDENTICAL to what was already committed -- so nothing
# on the front page changed, and thirteen artefacts stopped being unwatched.
previews/2-lead_3-bight_knot_radius30mm.svg :: target/release/preview 2-lead_3-bight_knot_radius30mm.svg $OUT
previews/2-lead_5-bight_knot_radius30mm.svg :: target/release/preview 2-lead_5-bight_knot_radius30mm.svg $OUT
previews/2-lead_7-bight_knot_radius30mm.svg :: target/release/preview 2-lead_7-bight_knot_radius30mm.svg $OUT
previews/3-lead_2-bight_knot_radius30mm.svg :: target/release/preview 3-lead_2-bight_knot_radius30mm.svg $OUT
previews/3-lead_4-bight_knot_radius30mm.svg :: target/release/preview 3-lead_4-bight_knot_radius30mm.svg $OUT
previews/3-lead_5-bight_knot_radius30mm.svg :: target/release/preview 3-lead_5-bight_knot_radius30mm.svg $OUT
previews/4-lead_3-bight_knot_radius39mm.svg :: target/release/preview 4-lead_3-bight_knot_radius39mm.svg $OUT
previews/4-lead_5-bight_knot_radius39mm.svg :: target/release/preview 4-lead_5-bight_knot_radius39mm.svg $OUT
previews/5-lead_4-bight_knot_radius60mm.svg :: target/release/preview 5-lead_4-bight_knot_radius60mm.svg $OUT
previews/9-lead_11-bight_knot_radius300mm.svg :: target/release/preview 9-lead_11-bight_knot_radius300mm.svg $OUT
previews/8-crossing_plait_radius30mm.svg :: target/release/preview 8-crossing_plait_radius30mm.svg $OUT
previews/10-crossing_plait_radius30mm.svg :: target/release/preview 10-crossing_plait_radius30mm.svg $OUT
previews/10-crossing_plait_radius50mm.svg :: target/release/preview 10-crossing_plait_radius50mm.svg $OUT

# --- the 3D view: every sample's waste taken out of a square of 3mm ply ---
# viewer.py imports turn3d.py from lasermade-tools, so it expects that
# checkout beside this one.
turn.html :: python3 viewer.py --out=$OUT

# --- the published pages ---
# Claimed here since 2026-09-10, when .repro learned to walk *.html. doc-audit
# checks these too, by rebuilding and comparing, but it pairs a page with a
# markdown document of the SAME NAME -- so it is the naming that carries the
# guarantee there, and a page renamed out from under it would go unwatched.
# This names the source explicitly instead. index.html is built from index.md,
# not from README.md, which is the case doc-audit's pairing gets right only
# because index.md happens to exist.
index.html :: python3 ../lasermade-tools/md2html.py index.md $OUT
knot_soundhole.html :: python3 ../lasermade-tools/md2html.py knot_soundhole.md $OUT
plait_soundhole.html :: python3 ../lasermade-tools/md2html.py plait_soundhole.md $OUT
